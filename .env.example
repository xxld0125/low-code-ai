# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# 属性配置面板环境变量
NEXT_PUBLIC_PROPERTY_PANEL_DEBUG=false
NEXT_PUBLIC_PROPERTY_PANEL_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_PROPERTY_PANEL_MAX_PROPERTIES=1000
NEXT_PUBLIC_PROPERTY_PANEL_DEBOUNCE_MS=100

# 开发环境配置
NEXT_PUBLIC_DESIGNER_REALTIME_PREVIEW=true
NEXT_PUBLIC_DESIGNER_AUTO_SAVE=false
